<Window x:Class="FluentStart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:FluentStart"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Start" Width="700" Height="720"
        WindowStyle="None" ResizeMode="CanResize" MinHeight="480" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Transparent"
        FontFamily="{DynamicResource Font.App}" FontSize="{DynamicResource FontSize.App}" Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput" PreviewMouseDown="Window_PreviewMouseDown"
        Closing="Window_Closing">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="6"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- App-list row geometry: the ONE definition shared by app rows and letter-header rows, so their hover rectangles cannot diverge.
         Hover rect = row Grid minus RowMargin; the icon's left edge and the header letter's ink both sit at RowPadding.Left inside it. -->
    <sys:Double x:Key="RowHeight">40</sys:Double>
    <Thickness x:Key="RowMargin">12,1,12,1</Thickness>
    <Thickness x:Key="RowPadding">16,0,12,0</Thickness>
    <CornerRadius x:Key="RowCorner">6</CornerRadius>
    <sys:Double x:Key="RowIconSize">24</sys:Double>
    <GridLength x:Key="RowIconColumn">24</GridLength>
    <local:InkInsetConverter x:Key="InkInset"/>


    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>

    <Style x:Key="RailButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Ui}"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Margin="4,2" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              </Trigger>
              <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GroupHeaderButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Ui}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- identical structure to AppItemStyle: Grid(RowMargin, RowHeight) > Bd(RowPadding) + focus ring -->
            <Grid Height="{StaticResource RowHeight}" Margin="{StaticResource RowMargin}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
              <Border x:Name="Bd" CornerRadius="{StaticResource RowCorner}" Background="Transparent" Padding="{StaticResource RowPadding}">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center">
                  <ContentPresenter.Margin>
                    <MultiBinding Converter="{StaticResource InkInset}">
                      <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <Binding Path="FontWeight" RelativeSource="{RelativeSource TemplatedParent}"/>
                    </MultiBinding>
                  </ContentPresenter.Margin>
                </ContentPresenter>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="JumpButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InlineClearButton" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="14" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TileButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentTile}"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tile_ResetKeyboardFocus"/>
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style TargetType="Control">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Control">
                  <Border x:Name="KeyboardFocusRing" Margin="3" CornerRadius="5" BorderThickness="1"
                          BorderBrush="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" IsHitTestVisible="False">
                    <Border CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
                <Grid>
                  <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                  <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"/>
                  <ContentPresenter Margin="2"/>
                  <Grid x:Name="HoverOverlay" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                    <Border CornerRadius="8" BorderThickness="3" BorderBrush="#66000000"/>
                    <Border x:Name="HoverBorder" Margin="1" CornerRadius="7" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.TileHover}"/>
                  </Grid>
                </Grid>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible"/>
                </MultiTrigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="HoverOverlay" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Pressed}"/>
                </Trigger>
             </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding DataContext.UseIconColors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
            <Condition Binding="{Binding App.HasIconColor}" Value="True"/>
             <Condition Binding="{Binding UseAccent}" Value="False"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="{Binding App.TileBrush}"/>
        </MultiDataTrigger>
        <!-- live system accent colour -->
         <DataTrigger Binding="{Binding UseAccent}" Value="True">
           <Setter Property="Background" Value="{DynamicResource Brush.AccentTile}"/>
         </DataTrigger>
         <!-- a colour picked from the tile's context menu wins over both -->
        <DataTrigger Binding="{Binding HasCustomColor}" Value="True">
          <Setter Property="Background" Value="{Binding TileBackground}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AppItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="{StaticResource RowHeight}" Margin="{StaticResource RowMargin}" HorizontalAlignment="Stretch">
              <Border x:Name="Bd" CornerRadius="{StaticResource RowCorner}" Background="Transparent" Padding="{StaticResource RowPadding}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              </Trigger>
              <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="MouseLeftButtonUp" Handler="AppItem_Click"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Drag_Down"/>
      <EventSetter Event="PreviewMouseMove" Handler="ListItem_Move"/>
    </Style>

    <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="6,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="6,0" BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter/>
              </Border>
              <Border x:Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="MouseLeftButtonUp" Handler="Result_Click"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Result_DragDown"/>
      <EventSetter Event="PreviewMouseMove" Handler="Result_DragMove"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide"/>
    </Grid.RenderTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="48"/>
      <ColumnDefinition x:Name="ListColumn" Width="300"/>
      <ColumnDefinition x:Name="TilesColumn" Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- App list -->
    <ListBox x:Name="AppList" Grid.Column="1" Grid.Row="1"
             ItemsSource="{Binding AppsView}"
             Loaded="AppList_Loaded"
             Background="Transparent" BorderThickness="0" Margin="0,4,4,0"
             ItemContainerStyle="{StaticResource AppItemStyle}"
             AutomationProperties.Name="Apps"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.GroupStyle>
        <GroupStyle>
          <!-- Explicit container: no margin/padding/alignment inherited from the default GroupItem template, so a header row
               spans exactly the same width as an app row. -->
          <GroupStyle.ContainerStyle>
            <Style TargetType="GroupItem">
              <Setter Property="Margin" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="HorizontalAlignment" Value="Stretch"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="GroupItem">
                    <StackPanel HorizontalAlignment="Stretch">
                      <ContentPresenter HorizontalAlignment="Stretch"/>
                      <ItemsPresenter HorizontalAlignment="Stretch"/>
                    </StackPanel>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <Button Style="{StaticResource GroupHeaderButton}" Content="{Binding Name}" Click="GroupHeader_Click" MouseRightButtonUp="GroupHeader_RightClick"/>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Height="{StaticResource RowHeight}" Background="Transparent" Margin="{Binding Indent}" MouseRightButtonUp="ListItem_RightClick" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{Binding App.DisplayName}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding App.IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.5"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource RowIconColumn}"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- app icon (apps) / folder glyph (Start-menu folders): the icon box starts exactly at RowPadding.Left -->
            <Image Source="{Binding App.Icon}" Width="{StaticResource RowIconSize}" Height="{StaticResource RowIconSize}" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE8B7;"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                      <Setter Property="Text" Value="&#xE838;"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="1" Text="{Binding App.DisplayName}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.App}" Margin="14,0,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowEditor}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox Grid.Column="1" MinHeight="32" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Margin="7,0,6,0"
                     Text="{Binding App.EditText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVis}}"
                     IsVisibleChanged="RenameBox_IsVisibleChanged"
                     PreviewKeyDown="RenameBox_KeyDown"
                     LostKeyboardFocus="RenameBox_LostFocus"
                     FontSize="{DynamicResource FontSize.App}"/>

            <!-- expand/collapse chevron (folders only): rotates when the folder expands -->
            <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                       Margin="8,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="RenderTransform">
                    <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                      <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Tiles -->
    <ScrollViewer x:Name="TilesScroll" Grid.Column="2" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0" Margin="0,4,0,0"
                  KeyboardNavigation.DirectionalNavigation="Contained">
      <!-- the old ScrollViewer padding (12,6,4,12) lives here as a margin: padding is outside the scrolled area and clips anything that
           hangs over the content's edge, such as the group-rename box that is pulled left to line its text up with the group name -->
      <StackPanel HorizontalAlignment="Left" Margin="12,6,4,12">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8" HorizontalAlignment="Left" Background="Transparent" Tag="TileGroupHost">
                 <StackPanel.Style>
                   <Style TargetType="StackPanel">
                     <Style.Triggers>
                       <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                         <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
                       </DataTrigger>
                     </Style.Triggers>
                   </Style>
                 </StackPanel.Style>
                   <Border Tag="TileGroupHeader" Margin="0,6,6,2" Padding="0,0,10,0" MinHeight="32" CornerRadius="6" Background="Transparent"
                           MouseLeftButtonDown="GroupHeader_MouseDown" MouseMove="GroupHeader_Move"
                           MouseRightButtonUp="GroupHeader_RightClick">
                     <Grid>
                       <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="22" Background="Transparent"
                               ToolTip="Drag to move this group"
                               MouseLeftButtonDown="GroupHeader_MouseDown" MouseMove="GroupHeader_Move">
                         <Border.Style>
                           <Style TargetType="Border">
                             <Setter Property="Opacity" Value="0"/>
                             <Style.Triggers>
                               <Trigger Property="IsMouseOver" Value="True">
                                 <Setter Property="Opacity" Value="1"/>
                               </Trigger>
                             </Style.Triggers>
                           </Style>
                         </Border.Style>
                         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                           <Rectangle Width="14" Height="2" Fill="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                           <Rectangle Width="14" Height="2" Fill="{DynamicResource Brush.TextSecondary}"/>
                         </StackPanel>
                       </Border>
                       <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.Ui}" FontSize="{DynamicResource FontSize.Ui}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                  MouseLeftButtonDown="GroupHeader_MouseDown" Background="Transparent">
                         <TextBlock.Style>
                           <Style TargetType="TextBlock">
                             <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                             <Style.Triggers>
                               <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                 <Setter Property="Visibility" Value="Collapsed"/>
                               </DataTrigger>
                             </Style.Triggers>
                           </Style>
                         </TextBlock.Style>
                       </TextBlock>
                        <TextBox FontFamily="{DynamicResource Font.Ui}" FontSize="{DynamicResource FontSize.Ui}" FontWeight="SemiBold" VerticalContentAlignment="Center" MinWidth="200" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="-7,0,4,0"
                                Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                IsVisibleChanged="RenameBox_IsVisibleChanged"
                                PreviewKeyDown="GroupBox_KeyDown"
                                LostKeyboardFocus="GroupBox_LostFocus"/>
                     </Grid>
                   </Border>
                <ItemsControl ItemsSource="{Binding Tiles}" MinHeight="52">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <local:TilePanel Columns="{Binding DataContext.TileColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource TileButton}" Margin="2"
                              Width="{Binding Width}" Height="{Binding Height}"
                              AutomationProperties.Name="{Binding App.DisplayName}"
                              ToolTip="{Binding App.DisplayName}" ToolTipService.IsEnabled="{Binding LabelHidden}"
                              Visibility="{Binding IsResolved, Converter={StaticResource BoolToVis}}"
                              Click="Tile_Click" MouseRightButtonUp="Tile_RightClick"
                              PreviewMouseLeftButtonDown="Drag_Down" PreviewMouseMove="Tile_Move">
                        <Grid>
                          <Image Source="{Binding App.Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                          <TextBlock Text="{Binding App.DisplayName}" FontSize="12"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                     Margin="8,0,8,6" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TileLabel}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasCustomColor}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding LabelBrush}"/>
                                  </DataTrigger>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Binding="{Binding ShowLabel}" Value="True"/>
                                      <Condition Binding="{Binding App.IsEditing}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </MultiDataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBox Tag="{Binding App}" Height="28" MinHeight="0" Padding="6,0,6,0" VerticalAlignment="Bottom" VerticalContentAlignment="Center" Margin="4,0,4,4" Text="{Binding App.EditText, UpdateSourceTrigger=PropertyChanged}"
                                   Visibility="{Binding App.IsEditing, Converter={StaticResource BoolToVis}}"
                                   IsVisibleChanged="RenameBox_IsVisibleChanged"
                                   PreviewKeyDown="RenameBox_KeyDown"
                                   LostKeyboardFocus="RenameBox_LostFocus" FontSize="{DynamicResource FontSize.App}"/>                         </Grid>                       </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <!-- A-Z jump overlay -->
    <Grid x:Name="JumpOverlay" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" Background="Transparent" Margin="0,4,4,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="8,8,8,0">
        <Button x:Name="JumpBackButton" Click="JumpBack_Click" HorizontalAlignment="Right" Style="{StaticResource RailButton}" Padding="18,6,18,6">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Back" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="8,8,8,8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <UniformGrid x:Name="JumpGrid" Columns="4" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- Search results page (Windows 11 style: filter chips, grouped results, detail pane) -->
    <Grid x:Name="SearchPage" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Visibility="Collapsed" Opacity="0">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="SearchSlide"/>
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="DetailColumn" Width="270"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.ColumnSpan="2" Margin="12,8,12,4">
        <WrapPanel x:Name="FilterChips" Orientation="Horizontal" Margin="0,0,0,-6">
          <RadioButton Style="{StaticResource Chip}" Content="All" Tag="All" IsChecked="True" GroupName="SearchFilter" Checked="Filter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" Content="Apps" Tag="Apps" GroupName="SearchFilter" Checked="Filter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" Content="Documents" Tag="Documents" GroupName="SearchFilter" Checked="Filter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" Content="Folders" Tag="Folders" GroupName="SearchFilter" Checked="Filter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" Content="Settings" Tag="Settings" GroupName="SearchFilter" Checked="Filter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" Content="Web" Tag="Web" GroupName="SearchFilter" Checked="Filter_Checked"/>
        </WrapPanel>
        <TextBlock Text="{Binding SourceNote}" FontSize="11" Margin="4,8,0,0"
                   Foreground="{DynamicResource Brush.TextSecondary}"/>
      </StackPanel>

      <ListBox x:Name="ResultsList" Grid.Row="1" ItemsSource="{Binding ResultsView}"
               SelectedItem="{Binding Selected, Mode=TwoWay}"
               Background="Transparent" BorderThickness="0" Margin="6,0,0,0"
               ItemContainerStyle="{StaticResource ResultItemStyle}"
               AutomationProperties.Name="Search results"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.CanContentScroll="False">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="12,8,0,4"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Height="54" Background="Transparent" AutomationProperties.Name="{Binding Title}" MouseRightButtonUp="Result_RightClick">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="32" Height="32">
                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border x:Name="DetailPane" Grid.Row="1" Grid.Column="1" Margin="8,2,12,10" Padding="18" CornerRadius="8"
              BorderThickness="1" Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.ControlStroke}"
              DataContext="{Binding Selected}">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <Grid Width="72" Height="72" HorizontalAlignment="Left" Margin="0,0,0,12">
            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="44"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding KindLabel}" FontSize="12" Margin="0,2,0,0"
                     Foreground="{DynamicResource Brush.TextSecondary}"/>
           <TextBlock Text="{Binding PreviewText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{DynamicResource Brush.TextSecondary}" Visibility="Visible">
             <TextBlock.Style>
               <Style TargetType="TextBlock">
                 <Style.Triggers>
                   <DataTrigger Binding="{Binding PreviewText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                   <DataTrigger Binding="{Binding PreviewText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                 </Style.Triggers>
               </Style>
             </TextBlock.Style>
           </TextBlock>
            <Image Source="{Binding PreviewImage}" MaxWidth="320" MaxHeight="240" Margin="0,8,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Style>
                <Style TargetType="Image">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
            <TextBlock Text="Loading preview..." FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Visibility="Collapsed">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLoadingPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          <Border Height="1" Margin="0,14" Background="{DynamicResource Brush.Divider}"/>
          <ItemsControl ItemsSource="{Binding Actions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource ActionRow}" Click="ResultAction_Click" AutomationProperties.Name="{Binding Label}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="28"/>
                    <TextBlock Text="{Binding Label}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding EmptyText}" FontSize="16"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                 Foreground="{DynamicResource Brush.TextSecondary}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
    </Grid>

    <Button x:Name="SectionButton" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
            HorizontalAlignment="Center" Height="36" Padding="12,0" Visibility="Collapsed"
            Style="{StaticResource RailButton}" Click="SectionButton_Click">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock x:Name="SectionLabel" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
        <TextBlock x:Name="SectionGlyph" FontFamily="{StaticResource IconFont}" FontSize="12"
                   Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
      </StackPanel>
    </Button>

    <!-- Search -->
    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,8,16,12">
      <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" Height="40" FocusVisualStyle="{x:Null}"
               Tag="Search for apps, settings and documents"
               AutomationProperties.Name="Search apps, settings and files"
               TextChanged="SearchBox_TextChanged" GotKeyboardFocus="SearchBox_GotKeyboardFocus"
               LostKeyboardFocus="SearchBox_LostKeyboardFocus" VerticalContentAlignment="Center"/>
       <TextBlock x:Name="SearchGlyph" Text="&#xE721;" FontFamily="{StaticResource IconFont}" HorizontalAlignment="Right"
                 VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"
                 Foreground="{DynamicResource Brush.TextSecondary}"/>
      <Button x:Name="SearchClearButton" Style="{StaticResource InlineClearButton}" HorizontalAlignment="Right"
              VerticalAlignment="Center" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"
              Click="SearchClear_Click" Visibility="Collapsed"/>
    </Grid>

    <!-- Left rail (overlays the content when expanded) -->
    <Grid x:Name="RailGrid" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="3" Width="48"
          HorizontalAlignment="Left" ClipToBounds="True" Panel.ZIndex="10" Background="Transparent">
      <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
         <Button Style="{StaticResource RailButton}" Tag="top" ToolTip="Expand" Click="Rail_Click"
                 AutomationProperties.Name="Expand navigation">
           <StackPanel Orientation="Horizontal">
             <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
             <TextBlock x:Name="RailStartLabel" Text="Start" Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
           </StackPanel>
         </Button>
        <Button x:Name="ViewToggleButton" Style="{StaticResource RailButton}" Tag="viewtoggle" Visibility="Collapsed"
                ToolTip="Switch between apps and tiles" Click="Rail_Click" AutomationProperties.Name="Switch between apps and tiles">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ViewToggleGlyph" Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="ViewToggleLabel" Text="Tiles" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,2">
        <Button x:Name="UserButton" Style="{StaticResource RailButton}" Tag="user" ToolTip="Account" Click="Rail_Click"
                AutomationProperties.Name="Account">
          <StackPanel Orientation="Horizontal">
            <Grid Width="40" Height="28">
              <TextBlock x:Name="UserGlyph" Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                         TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Ellipse x:Name="UserPic" Width="26" Height="26" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="UserLabel" Text="Account" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="DocsButton" Style="{StaticResource RailButton}" Tag="docs" ToolTip="Documents" Click="Rail_Click"
                AutomationProperties.Name="Documents">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="DocsLabel" Text="Documents" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="PicsButton" Style="{StaticResource RailButton}" Tag="pics" ToolTip="Pictures" Click="Rail_Click"
                AutomationProperties.Name="Pictures">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="PicsLabel" Text="Pictures" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ItemsControl x:Name="FolderRailButtons" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource RailButton}" Click="FolderRailButton_Click" ToolTip="{Binding Name}"
                      AutomationProperties.Name="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="40" Height="28">
                    <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                               TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="SettingsButton" Style="{StaticResource RailButton}" Tag="settings" ToolTip="Settings (right-click for FluentStart settings)" Click="Rail_Click" MouseRightButtonUp="Rail_RightClick"
                AutomationProperties.Name="Settings">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="SettingsLabel" Text="Settings" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ItemsControl x:Name="CustomRailButtons" ItemsSource="{Binding CustomRailButtons}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource RailButton}" Click="CustomRailButton_Click" ToolTip="{Binding Name}"
                      AutomationProperties.Name="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource RailButton}" Tag="power" ToolTip="Power" Click="Rail_Click"
                AutomationProperties.Name="Power">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="PowerLabel" Text="Power" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  <!-- Folder tile: its apps in a panel over the Start menu (see MainWindow.FolderOverlay.cs) -->
  <Grid x:Name="FolderOverlay" Grid.ColumnSpan="3" Grid.RowSpan="10" Visibility="Collapsed" Background="#01000000"
        MouseLeftButtonDown="FolderOverlay_MouseDown" MouseRightButtonDown="FolderOverlay_MouseDown">
    <Border x:Name="FolderPanel" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="12" BorderThickness="1"
            Padding="16,14,16,16" Background="{DynamicResource Brush.Flyout}" BorderBrush="{DynamicResource Brush.Stroke}"
            MouseLeftButtonDown="FolderPanel_MouseDown" MouseRightButtonDown="FolderPanel_MouseDown">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black"/>
      </Border.Effect>
      <StackPanel>
        <TextBlock x:Name="FolderTitle" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,10" Foreground="{DynamicResource Brush.Text}"/>
        <ItemsControl x:Name="FolderItems" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Width="288"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Width="96" Height="98" Padding="4" Background="Transparent" BorderThickness="0"
                      Click="FolderApp_Click" MouseRightButtonUp="FolderApp_RightClick" ToolTip="{Binding DisplayName}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Image Source="{Binding Icon}" Width="40" Height="40" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock Text="{Binding DisplayName}" FontSize="12" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis" MaxHeight="34" Foreground="{DynamicResource Brush.Text}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
  <!-- Drag layer: the lifted item, hint pill and insertion line live here, above everything else (see MainWindow.Drag.cs) -->
  <Canvas x:Name="DragLayer" Grid.ColumnSpan="3" Grid.RowSpan="10" IsHitTestVisible="False" Visibility="Collapsed"/>
  </Grid>
</Window>
