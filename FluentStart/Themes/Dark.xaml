<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B3FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Hover" Color="#1AFFFFFF"/>
  <LinearGradientBrush x:Key="Brush.TileHover" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#B3FFFFFF" Offset="0"/>
    <GradientStop Color="#80FFFFFF" Offset="0.5"/>
    <GradientStop Color="#40FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.Pressed" Color="#0DFFFFFF"/>
  <SolidColorBrush x:Key="Brush.Overlay" Color="#F0202020"/>
  <SolidColorBrush x:Key="Brush.Stroke" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="Brush.WindowBg" Color="#FF202020"/>
  <SolidColorBrush x:Key="Brush.Flyout" Color="#FF2B2B2B"/>
  <SolidColorBrush x:Key="Brush.Control" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="Brush.ControlHover" Color="#15FFFFFF"/>
  <SolidColorBrush x:Key="Brush.ControlStroke" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#9AFFFFFF"/>
  <SolidColorBrush x:Key="Brush.Divider" Color="#14FFFFFF"/>
</ResourceDictionary>
