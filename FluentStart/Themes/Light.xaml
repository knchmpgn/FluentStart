<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Text" Color="#FF1A1A1A"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#99000000"/>
  <SolidColorBrush x:Key="Brush.Hover" Color="#14000000"/>
  <LinearGradientBrush x:Key="Brush.TileHover" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#99FFFFFF" Offset="0"/>
    <GradientStop Color="#66FFFFFF" Offset="0.5"/>
    <GradientStop Color="#33FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.Pressed" Color="#0A000000"/>
  <SolidColorBrush x:Key="Brush.Overlay" Color="#F2F3F3F3"/>
  <SolidColorBrush x:Key="Brush.Stroke" Color="#1A000000"/>
  <SolidColorBrush x:Key="Brush.WindowBg" Color="#FFF3F3F3"/>
  <SolidColorBrush x:Key="Brush.Flyout" Color="#FFFCFCFC"/>
  <SolidColorBrush x:Key="Brush.Control" Color="#B3FFFFFF"/>
  <SolidColorBrush x:Key="Brush.ControlHover" Color="#80F9F9F9"/>
  <SolidColorBrush x:Key="Brush.ControlStroke" Color="#0F000000"/>
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#9C000000"/>
  <SolidColorBrush x:Key="Brush.Divider" Color="#0F000000"/>
</ResourceDictionary>
