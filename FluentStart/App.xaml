<Application x:Class="FluentStart.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Dark.xaml"/>
        <ResourceDictionary Source="Themes/Fluent.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Brush.Accent" Color="{x:Static SystemParameters.WindowGlassColor}"/>
      <SolidColorBrush x:Key="Brush.AccentHover" Color="{x:Static SystemParameters.WindowGlassColor}" Opacity="0.9"/>
      <SolidColorBrush x:Key="Brush.AccentPressed" Color="{x:Static SystemParameters.WindowGlassColor}" Opacity="0.8"/>
      <SolidColorBrush x:Key="Brush.AccentTile" Color="{x:Static SystemParameters.WindowGlassColor}"/>
      <SolidColorBrush x:Key="Brush.OnAccent" Color="White"/>
      <SolidColorBrush x:Key="Brush.TileLabel" Color="White"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
